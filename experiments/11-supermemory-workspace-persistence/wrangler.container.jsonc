{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dejavu-exp11-workspace-container",
  "main": "src/container-worker.ts",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [{
    "class_name": "MemoryContainer",
    "image": "./Dockerfile",
    "instance_type": "standard-2",
    "max_instances": 1
  }],
  "durable_objects": {
    "bindings": [{ "name": "MEMORY_CONTAINER", "class_name": "MemoryContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MemoryContainer"] }]
}
