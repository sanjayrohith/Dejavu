---
interface Props { name: string; body: string }
const { name, body } = Astro.props;
---
<div class="border border-brass/10 rounded-sm bg-steel/20 px-4 py-4">
  <code class="font-mono text-[12px] text-brass-light">{name}</code>
  <p class="font-serif font-light text-[13px] text-chrome-dark/85 leading-relaxed mt-2">{body}</p>
</div>
