---
interface Props { value: string; label: string }
const { value, label } = Astro.props;
---
<div class="border border-brass/15 rounded-sm bg-steel/30 p-5 shadow-card mb-5">
  <div class="font-serif text-3xl text-brass-light mb-1">{value}</div>
  <div class="font-mono text-[10px] tracking-[0.18em] uppercase text-chrome-dark/70">{label}</div>
</div>
