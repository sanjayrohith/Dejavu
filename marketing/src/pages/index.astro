---
import Base from "../layouts/Base.astro";
import Feature from "../components/Feature.astro";
import CodeCard from "../components/CodeCard.astro";
import Tool from "../components/Tool.astro";
import Metric from "../components/Metric.astro";
---

<Base
  title="dejavu — memory for coding agents"
  description="Repository-scoped, local-first memory that lets coding agents continue instead of start over."
>
  <section class="pt-16 sm:pt-24 pb-16">
    <div class="relative border border-brass/20 rounded-sm p-8 sm:p-14 overflow-hidden bg-cover bg-center shadow-hero">
      <div class="absolute inset-0 bg-cover bg-center -z-10 opacity-80" style="background-image: url('/brain.jpg');"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-void/75 via-void/90 to-void -z-10"></div>
      <div class="font-mono text-[11px] font-bold tracking-[0.28em] uppercase text-brass mb-5">
        local-first · repository-scoped · agent-native
      </div>
      <h1 class="font-serif-sc text-[3.5rem] sm:text-[5.5rem] leading-none font-bold tracking-tight m-0 mb-6">dejavu</h1>
      <p class="font-serif font-light text-xl sm:text-2xl text-chrome max-w-[760px] mb-4 leading-relaxed">
        Memory that lets coding agents continue instead of start over.
      </p>
      <p class="font-serif font-light text-base text-chrome-dark max-w-[720px] mb-9 leading-relaxed">
        Decisions, procedures, pitfalls, preferences, and active work in one inspectable SQLite file. Recall is local, bounded, cited, and isolated to the repository you are actually working in.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="#install" class="font-mono px-6 py-3.5 rounded-sm font-semibold text-[11px] tracking-[0.18em] uppercase border border-brass-dark bg-gradient-to-b from-steel-light to-steel text-chrome shadow-btn hover:-translate-y-px transition-transform">Install</a>
        <a href="https://github.com/acoyfellow/dejavu" class="font-mono px-6 py-3.5 rounded-sm font-semibold text-[11px] tracking-[0.18em] uppercase border border-brass/20 text-chrome-dark hover:bg-brass/5 hover:text-brass transition-colors">GitHub</a>
        <a href="https://github.com/acoyfellow/dejavu/blob/main/docs/ROADMAP.md" class="font-mono px-6 py-3.5 rounded-sm font-semibold text-[11px] tracking-[0.18em] uppercase border border-brass/20 text-chrome-dark hover:bg-brass/5 hover:text-brass transition-colors">Roadmap</a>
      </div>
      <div class="mt-12 grid grid-cols-2 sm:grid-cols-4 gap-6 font-mono text-[10px] uppercase tracking-[0.16em] text-chrome-dark/75">
        <div><div class="text-brass-light mb-1">Storage</div><div>SQLite + FTS5</div></div>
        <div><div class="text-brass-light mb-1">Scope</div><div>Git repository</div></div>
        <div><div class="text-brass-light mb-1">Context</div><div>Token bounded</div></div>
        <div><div class="text-brass-light mb-1">Runtime</div><div>Bun + MCP</div></div>
      </div>
    </div>
  </section>

  <section class="py-14">
    <div class="mb-10">
      <div class="font-mono text-[11px] font-bold tracking-[0.28em] uppercase text-brass mb-3">why memory fails</div>
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight m-0 mb-3">A database is not enough.</h2>
      <p class="font-serif font-light text-chrome-dark max-w-[760px] leading-relaxed">
        Memory has to appear in the right project, fit inside the prompt, preserve corrections, stop repeating completed instructions, and show evidence when it gets something wrong. Dejavu builds those constraints into the tool.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <Feature eyebrow="scope" title="No project soup" body="A stable scope comes from the Git origin. Two checkouts can share memory; unrelated repositories cannot leak slips or handoffs." />
      <Feature eyebrow="budget" title="No transcript dump" body="Recall accepts a context budget and memory-kind filters. It returns the smallest useful packet, not the whole conversation history." />
      <Feature eyebrow="truth" title="No silent rewrites" body="A correction supersedes or contradicts an immutable older slip. Recall follows current truth while the evidence remains inspectable." />
    </div>
  </section>

  <section class="py-14" id="mechanism">
    <div class="mb-10">
      <div class="font-mono text-[11px] font-bold tracking-[0.28em] uppercase text-brass mb-3">the mechanism</div>
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight m-0 mb-3">Write less. Recover more.</h2>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
      <CodeCard label="finish a session" code={`const decision = d.remember(
  "Decision: use Bun for repo scripts",
  { kind: "decision" }
);

d.keep([decision.id]);

d.handoff({
  summary: "Converted scripts; tests pass.",
  next: ["update the release workflow"],
});`} />
      <CodeCard label="start the next one" code={`const context = d.recall("release workflow", {
  maxTokens: 600,
  kinds: ["decision", "pitfall", "wip"],
});

// repository-scoped hits
// one active handoff
// provenance + evidence trust
// a receipt to evaluate later

d.assessRecall(context.traceId, "useful");`} />
    </div>
  </section>

  <section class="py-14">
    <div class="mb-10">
      <div class="font-mono text-[11px] font-bold tracking-[0.28em] uppercase text-brass mb-3">v0.1.0</div>
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight m-0 mb-3">A complete local memory loop.</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <Feature eyebrow="typed memory" title="Seven useful kinds" body="Decision, preference, procedure, pitfall, fact, WIP, and note. Agents may classify explicitly; the fallback is deterministic and conservative." />
      <Feature eyebrow="evidence trust" title="Relevance is not truth" body="BM25 finds matching text. Draft/kept state and used/wrong outcomes determine trust. High means repeatedly useful—not magically authoritative." />
      <Feature eyebrow="handoff lifecycle" title="Old work stops directing" body="Handoffs are active, completed, or abandoned. Only active handoffs from the current repository reach a fresh agent." />
      <Feature eyebrow="feedback" title="Recall can be evaluated" body="Every retrieval has a content-free receipt. Mark it useful, wrong, missed, or unnecessary, then inspect real scoped quality with dejavu eval." />
      <Feature eyebrow="correction" title="Supersession is explicit" body="Link new memory to old as supersedes, contradicts, or related. Old lexical matches resolve to the current slip without deleting history." />
      <Feature eyebrow="inspection" title="One file, ordinary tools" body="Open ~/.dejavu/dejavu.db with SQLite. Use the library, MCP tools, or CLI. No daemon, account, hidden model call, or remote ingestion path." />
    </div>
  </section>

  <section id="install" class="py-14 scroll-mt-24">
    <div class="mb-10">
      <div class="font-mono text-[11px] font-bold tracking-[0.28em] uppercase text-brass mb-3">install</div>
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight m-0 mb-3">Give an agent memory in sixty seconds.</h2>
    </div>
    <CodeCard label="terminal" code={`bun add github:acoyfellow/dejavu
bunx github:acoyfellow/dejavu init`} />
    <div class="mt-5 border border-brass/15 rounded-sm bg-steel/30 shadow-card overflow-hidden">
      <div class="border-b border-brass/10 px-5 py-3 bg-void-deep/50 font-mono text-[10px] tracking-[0.2em] uppercase text-brass-light">MCP configuration</div>
      <pre class="font-mono text-[12px] leading-relaxed text-chrome-dark p-5 overflow-x-auto">{`{
  "mcpServers": {
    "dejavu": {
      "command": "bunx",
      "args": ["github:acoyfellow/dejavu", "mcp"]
    }
  }
}`}</pre>
    </div>
    <p class="font-serif font-light text-sm text-chrome-dark/80 max-w-[760px] mt-5 leading-relaxed">
      Tool descriptions are the operating contract. No SKILL.md, AGENTS.md, or memory prompt copied into every session.
    </p>
  </section>

  <section class="py-14">
    <div class="mb-10">
      <div class="font-mono text-[11px] font-bold tracking-[0.28em] uppercase text-brass mb-3">agent tools</div>
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight m-0 mb-3">Small primitives, closed loop.</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <Tool name="recall" body="Scoped, budgeted context plus the active handoff." />
      <Tool name="remember" body="Draft or keep typed memory; link corrections immediately." />
      <Tool name="handoff" body="Leave one continuation packet for the next session." />
      <Tool name="resolve_handoff" body="Complete or abandon work so it stops resurfacing." />
      <Tool name="signal" body="Mark one memory used, wrong, or forgotten." />
      <Tool name="assess" body="Evaluate the whole recall receipt after acting." />
      <Tool name="link" body="Supersede, contradict, or relate existing slips." />
      <Tool name="send / inbox / reply" body="Optional local coordination; deliberately separate from memory truth." />
    </div>
  </section>

  <section class="py-14" id="evidence">
    <div class="mb-10">
      <div class="font-mono text-[11px] font-bold tracking-[0.28em] uppercase text-brass mb-3">evidence, not slogans</div>
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight m-0 mb-3">The failures stay in the repository.</h2>
      <p class="font-serif font-light text-chrome-dark max-w-[760px] leading-relaxed">
        Dejavu includes behavior loops, negative results, protocol experiments, claim-to-evidence mapping, and a one-command release gate. The eight-case lexical score is a smoke test—not proof that memory improves every agent.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <Metric value="local" label="SQLite recall path" />
      <Metric value="0" label="wrong-project fixture hits" />
      <Metric value="4" label="release-gate checks" />
    </div>
    <CodeCard label="release gate" code={`bun run check
# tests
# strict TypeScript
# lexical recall smoke bench
# behavioral evidence bench`} />
  </section>

  <section class="py-14" id="shared">
    <div class="border border-brass/20 rounded-sm p-7 sm:p-10 bg-steel/25 shadow-card">
      <div class="font-mono text-[11px] font-bold tracking-[0.28em] uppercase text-brass mb-3">preview · cloudflare only</div>
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight m-0 mb-4">Shared memory is real—and not yet deployable.</h2>
      <p class="font-serif font-light text-chrome-dark max-w-[780px] leading-relaxed mb-5">
        The preview uses a Cloudflare Worker, one Durable Object SQL authority per memory space, numbered commits, SSE, and rebuildable local SQLite mirrors. Read-after-write, live peer updates, explicit stale state, catch-up, and hard deletion are tested.
      </p>
      <p class="font-serif font-light text-chrome-dark max-w-[780px] leading-relaxed mb-6">
        It remains local dogfood until verified identity, revocation, retention, content policy, audit boundaries, and encryption are resolved. We will not call a bearer-token demo production.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="https://github.com/acoyfellow/dejavu/blob/main/docs/shared-memory.md" class="font-mono text-[11px] tracking-[0.16em] uppercase text-brass hover:underline">Protocol →</a>
        <a href="https://github.com/acoyfellow/dejavu/blob/main/docs/shared-security-review.md" class="font-mono text-[11px] tracking-[0.16em] uppercase text-brass hover:underline">Security review →</a>
      </div>
    </div>
  </section>

  <section class="py-14 pb-24">
    <div class="text-center border-t border-brass/10 pt-14">
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold tracking-tight mb-4">Let the next agent start further ahead.</h2>
      <p class="font-serif font-light text-chrome-dark mb-8">Local-first. Inspectable. Falsifiable. Built for the agent using it.</p>
      <a href="#install" class="font-mono px-7 py-4 rounded-sm font-semibold text-[11px] tracking-[0.18em] uppercase border border-brass-dark bg-gradient-to-b from-steel-light to-steel text-chrome shadow-btn">Install Dejavu</a>
    </div>
  </section>
</Base>
